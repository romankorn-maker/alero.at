---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const allPosts = await getCollection('aktuelles', ({ data }) =>
  !data.archived && !data.draft
);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const catMeta = {
  aktion:    { label: 'Aktion',    cls: 'bg-olive/10 text-olive border-olive/25' },
  sortiment: { label: 'Sortiment', cls: 'bg-ink/[0.06] text-ink/60 border-line' },
  tipps:     { label: 'Tipps',     cls: 'bg-cream text-ink/60 border-line' },
} as const;

function fmtDate(d: Date) {
  return d.toLocaleDateString('de-AT', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title="Aktuelles — Alero Handels GmbH | Neuigkeiten & Angebote"
  description="Aktuelle Neuigkeiten, Sonderangebote und praktische Tipps für Gastronomie- und Handelskunden von Alero Handels GmbH in Wien."
  canonical="https://alero.at/aktuelles"
>
  <PageHeader
    title="Aktuelles"
    subtitle="Neuigkeiten aus dem Sortiment, aktuelle Aktionen und praktische Tipps für Ihren Gastronomiebetrieb."
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Aktuelles' }]}
  />

  <section class="bg-paper">
    <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-20 md:py-28">

      <!-- CSS-only category filter: inputs must be siblings of filter-bar and posts-grid -->
      <div class="filter-root">
        <input type="radio" name="cat" id="f-all"       class="filter-radio" checked>
        <input type="radio" name="cat" id="f-aktion"    class="filter-radio">
        <input type="radio" name="cat" id="f-sortiment" class="filter-radio">
        <input type="radio" name="cat" id="f-tipps"     class="filter-radio">

        <div class="filter-bar reveal flex flex-wrap gap-2 mb-10">
          <label for="f-all"       class="filter-btn">Alle</label>
          <label for="f-aktion"    class="filter-btn">Aktionen</label>
          <label for="f-sortiment" class="filter-btn">Sortiment</label>
          <label for="f-tipps"     class="filter-btn">Tipps & Service</label>
        </div>

        <div class="posts-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post, i) => {
            const m = catMeta[post.data.category];
            return (
              <a
                href={`/aktuelles/${post.id}`}
                data-cat={post.data.category}
                class="post-card prod-card group reveal bg-white border border-line rounded-sm p-7 flex flex-col"
                style={`transition-delay:${(i % 3) * 60}ms`}
              >
                <div class="flex items-center justify-between mb-5">
                  <span class={`text-[11px] font-bold uppercase tracking-[0.18em] px-2.5 py-1 rounded-sm border ${m.cls}`}>
                    {m.label}
                  </span>
                  <time
                    class="text-[12px] text-ink/40 tabular"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {fmtDate(post.data.pubDate)}
                  </time>
                </div>

                <h2 class="font-display font-bold text-[22px] text-ink leading-tight mb-3 flex-1">
                  {post.data.title}
                </h2>

                <p class="text-[14px] text-ink/60 leading-relaxed mb-6 line-clamp-3">
                  {post.data.description}
                </p>

                <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
                  Mehr lesen <span class="prod-arrow inline-block">→</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Visually hidden radio inputs */
  .filter-radio {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  .filter-btn {
    display: inline-block;
    cursor: pointer;
    padding: 0.5rem 1.125rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 2px;
    border: 1px solid var(--color-line);
    background: white;
    color: var(--color-ink);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    user-select: none;
  }
  .filter-btn:hover {
    border-color: var(--color-olive);
    color: var(--color-olive);
  }

  /* Active filter label — general sibling combinator within .filter-root */
  #f-all:checked       ~ .filter-bar label[for="f-all"],
  #f-aktion:checked    ~ .filter-bar label[for="f-aktion"],
  #f-sortiment:checked ~ .filter-bar label[for="f-sortiment"],
  #f-tipps:checked     ~ .filter-bar label[for="f-tipps"] {
    background: var(--color-olive);
    color: white;
    border-color: var(--color-olive);
  }

  /* Hide non-matching posts when a category is selected */
  #f-aktion:checked    ~ .posts-grid [data-cat]:not([data-cat="aktion"]),
  #f-sortiment:checked ~ .posts-grid [data-cat]:not([data-cat="sortiment"]),
  #f-tipps:checked     ~ .posts-grid [data-cat]:not([data-cat="tipps"]) {
    display: none;
  }
</style>
