  />

  <section class="bg-paper">
    <div class="max-w-[820px] mx-auto px-6 md:px-8 py-16 md:py-24">
      <div class="legal space-y-10 text-ink/75 text-[15px] leading-[1.8]">

        <div>
          <h2 class="font-display font-bold text-ink text-xl mb-3">ALERO Handels GmbH</h2>
          <p>
            Dassanowskyweg 16a<br>
            1220 Wien<br>
            Österreich
          </p>
        </div>

        <div>
          <h3 class="font-display font-bold text-ink text-lg mb-3">Kontakt</h3>
          <p>
