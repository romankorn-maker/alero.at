---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

// ── Web3Forms ──────────────────────────────────────────────────────────
// Static-site form backend. Get a free key at https://web3forms.com
// (tie it to office@alero.at) and paste it below. Until then the form
// renders fine but submissions return an error.
const WEB3FORMS_ACCESS_KEY = 'REPLACE_WITH_WEB3FORMS_ACCESS_KEY';

const inputBase =
  'w-full bg-paper border border-line rounded-sm px-4 py-3 text-[14px] text-ink placeholder:text-ink/35 focus:outline-none focus:border-olive focus:ring-2 focus:ring-olive/20 transition';
const labelBase =
  'block text-[12px] font-semibold uppercase tracking-[0.12em] text-ink/55 mb-2';
---

<Layout
  title="Kontakt — Alero Handels GmbH | Großhandel Wien"
  description="Kontaktieren Sie Alero Handels GmbH in Wien: Schreiben Sie uns, rufen Sie an unter +43 1 748 95 20 oder bestellen Sie direkt in der Alero App. Mo–Fr erreichbar."
  canonical="https://alero.at/kontakt"
>
  <PageHeader
    title="Kontakt"
    subtitle="Wir sind Mo–Fr erreichbar. Schreiben Sie uns, rufen Sie an — oder bestellen Sie direkt in der Alero App."
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Kontakt' }]}
    image="/assets/banner-contact.webp"
    imageAlt="Alero Sortiment: Tiefkühlprodukte, Öl, Holzkohle und Brennholz"
  />

  <!-- ── FORM + SIDEBAR ─────────────────────────────────────────────── -->
  <section class="bg-paper">
    <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-20 md:py-28">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">

        <!-- Form -->
        <div class="reveal lg:col-span-7">
          <div class="bg-white border border-line rounded-sm p-7 md:p-10">
            <h2 class="font-display font-bold text-ink text-3xl md:text-[36px] leading-tight mb-2">
              Schreiben Sie uns
            </h2>
            <p class="text-ink/60 text-[15px] mb-8">Wir antworten innerhalb eines Werktages.</p>

            <form id="kontaktform" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
              <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
              <input type="hidden" name="subject" value="Neue Kontaktanfrage über alero.at" />
              <input type="hidden" name="from_name" value="alero.at — Kontaktformular" />
              <!-- Honeypot -->
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class={labelBase}>Name <span class="text-olive">*</span></label>
                  <input id="name" name="name" type="text" required autocomplete="name" placeholder="Ihr Name" class={inputBase} />
                </div>
                <div>
                  <label for="email" class={labelBase}>E-Mail <span class="text-olive">*</span></label>
                  <input id="email" name="email" type="email" required autocomplete="email" placeholder="name@betrieb.at" class={inputBase} />
                </div>
              </div>

              <div>
                <label for="telefon" class={labelBase}>Telefon</label>
                <input id="telefon" name="telefon" type="tel" autocomplete="tel" placeholder="Optional — für einen Rückruf" class={inputBase} />
              </div>

              <div>
                <label for="nachricht" class={labelBase}>Nachricht <span class="text-olive">*</span></label>
                <textarea id="nachricht" name="nachricht" required rows="5" placeholder="Wie können wir Ihnen helfen?" class={`${inputBase} resize-y`}></textarea>
              </div>

              <!-- Neukunde toggle (CSS-only reveal) -->
              <div class="pt-1">
                <input type="checkbox" id="neukunde" name="neukunde_interesse" value="Ja" class="peer sr-only" />
                <label
                  for="neukunde"
                  class="group flex items-center gap-3.5 cursor-pointer select-none peer-checked:[&_.tk-track]:bg-olive peer-checked:[&_.tk-dot]:translate-x-[18px] peer-focus-visible:[&_.tk-track]:ring-2 peer-focus-visible:[&_.tk-track]:ring-olive/30"
                >
                  <span class="tk-track relative w-11 h-6 rounded-full bg-ink/15 transition-colors duration-300 flex-shrink-0">
                    <span class="tk-dot absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm transition-transform duration-300"></span>
                  </span>
                  <span class="text-[14px] font-semibold text-ink">Möchten Sie Neukunde werden?</span>
                </label>

                <div class="grid grid-rows-[0fr] peer-checked:grid-rows-[1fr] transition-[grid-template-rows] duration-500 ease-out">
                  <div class="overflow-hidden">
                    <div class="grid sm:grid-cols-2 gap-5 pt-6">
                      <div>
                        <label for="firma" class={labelBase}>Firma</label>
                        <input id="firma" name="firma" type="text" autocomplete="organization" placeholder="Name Ihres Betriebs" class={inputBase} />
                      </div>
                      <div>
                        <label for="betrieb" class={labelBase}>Art des Betriebs</label>
                        <select id="betrieb" name="art_des_betriebs" class={`${inputBase} appearance-none cursor-pointer`}>
                          <option value="">Bitte wählen …</option>
                          <option>Restaurant</option>
                          <option>Imbiss / Take-away</option>
                          <option>Hotel</option>
                          <option>Catering</option>
                          <option>Einzelhandel</option>
                          <option>Sonstiges</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row sm:items-center gap-5 pt-2">
                <button
                  type="submit"
                  class="group bg-olive hover:bg-leaf transition text-white font-semibold px-7 py-4 rounded-sm flex items-center justify-center gap-3 text-[14px] disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <span class="btn-label">Nachricht senden</span>
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </button>
                <p class="text-[12px] text-ink/45 leading-relaxed">
                  Pflichtfelder mit <span class="text-olive">*</span> markiert · Ihre Daten werden nicht weitergegeben ·
                  <a href="/datenschutz" class="text-olive hover:text-ink underline underline-offset-2 transition">Datenschutzerklärung</a>
                </p>
              </div>

              <!-- Status messages -->
              <div id="form-success" class="hidden rounded-sm bg-olive/10 border border-olive/30 px-5 py-4 text-[14px] text-ink">
                <strong class="font-semibold">Vielen Dank!</strong> Ihre Nachricht ist bei uns eingegangen — wir melden uns innerhalb eines Werktages.
              </div>
              <div id="form-error" class="hidden rounded-sm bg-[#faece7] border border-[#f3d4c8] px-5 py-4 text-[14px] text-ink">
                Leider ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder rufen Sie uns an unter
                <a href="tel:+4317489520" class="text-olive font-semibold">+43 1 748 95 20</a>.
              </div>
            </form>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="reveal lg:col-span-5 lg:sticky lg:top-8" style="transition-delay:100ms">
          <div class="bg-inkdeep text-white rounded-sm p-7 md:p-9">
            <div class="text-[11px] uppercase tracking-[0.2em] text-olive font-semibold mb-1">Kontaktdaten</div>
            <div class="font-display font-bold text-2xl leading-tight mb-7">Alero Handels GmbH · Wien</div>

            <div class="space-y-6 text-[14px]">
              <div>
                <div class="text-[11px] uppercase tracking-[0.16em] text-white/40 font-semibold mb-2">Adresse</div>
                <address class="not-italic text-white/80 leading-[1.8]">
                  Alero Handels GmbH<br>
                  Dassanowskyweg 16a<br>
                  1220 Wien, Österreich
                </address>
              </div>

              <div>
                <div class="text-[11px] uppercase tracking-[0.16em] text-white/40 font-semibold mb-2">Telefon &amp; E-Mail</div>
                <div class="flex flex-col gap-1.5">
                  <a href="tel:+4317489520" class="text-olive hover:text-leaf transition font-semibold tabular">+43 1 748 95 20</a>
                  <a href="mailto:office@alero.at" class="text-olive hover:text-leaf transition">office@alero.at</a>
                </div>
              </div>

              <div class="pt-5 border-t border-white/10">
                <div class="text-[11px] uppercase tracking-[0.16em] text-white/40 font-semibold mb-2">Firmendaten</div>
                <div class="text-white/65 text-[13px] leading-[1.8]">
                  UID: <span class="tabular">ATU64668309</span><br>
                  FN: <span class="tabular">320642 h</span> · Handelsgericht Wien
                </div>
              </div>
            </div>
          </div>

          <!-- Google Maps (DSGVO: click-to-load) -->
          <div class="mt-6 rounded-sm overflow-hidden border border-line">
            <div id="map-placeholder" class="h-[220px] flex flex-col items-center justify-center text-center px-6">
              <svg class="w-7 h-7 text-olive mx-auto mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div class="font-display font-semibold text-ink text-[17px]">Dassanowskyweg 16a, 1220 Wien</div>
              <p class="text-[12px] text-ink/50 mt-1 mb-4 max-w-[34ch] mx-auto">Karte wird erst nach Ihrer Zustimmung von Google geladen.</p>
              <button id="map-load" type="button" class="bg-olive hover:bg-leaf transition text-white text-[13px] font-semibold px-5 py-2.5 rounded-sm">
                Karte laden
              </button>
              <a href="https://www.google.com/maps/dir/?api=1&destination=Dassanowskyweg+16a,+1220+Wien" target="_blank" rel="noopener" class="block mt-3 text-[12px] text-olive hover:text-ink transition font-medium">Route planen →</a>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- ── CTA: lieber anrufen ────────────────────────────────────────── -->
  <section class="bg-[#efeae0]">
    <div class="max-w-[1280px] mx-auto px-6 md:px-8 pb-20 md:pb-28">
      <div class="reveal border-t border-ink/10 pt-14 md:pt-16 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10">
        <div class="max-w-[52ch]">
          <div class="inline-flex items-center gap-2.5 mb-4">
            <span class="w-8 h-px bg-olive"></span>
            <span class="text-[11px] uppercase tracking-[0.25em] text-olive font-semibold">Neu bei Alero?</span>
          </div>
          <h2 class="font-display font-bold text-ink text-3xl md:text-[40px] leading-[1.05] mb-4">
            Wir beraten Sie gerne <span class="font-serif italic font-normal text-olive">persönlich</span>
          </h2>
          <p class="text-ink/65 text-[15px] leading-[1.7]">
            Rufen Sie uns an — wir erklären Ihnen alles zu Sortiment, Lieferung und App in einem kurzen Gespräch.
          </p>
          <div class="text-[12px] uppercase tracking-[0.16em] text-ink/40 mt-5">Mo–Do 8–17 · Fr 8–16</div>
        </div>
        <a href="tel:+4317489520" class="group flex-shrink-0 inline-flex items-center gap-3.5 bg-olive hover:bg-leaf transition text-white font-semibold px-8 py-5 rounded-sm shadow-card-hover">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          <span class="flex flex-col leading-tight">
            <span class="text-[11px] uppercase tracking-[0.16em] text-white/70 font-medium">Jetzt anrufen</span>
            <span class="text-[19px] tabular">+43 1 748 95 20</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact JSON-LD for SEO -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'Alero Handels GmbH',
    image: 'https://alero.at/assets/alero-logo-white.png',
    telephone: '+43 1 7489520',
    email: 'office@alero.at',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Dassanowskyweg 16a',
      postalCode: '1220',
      addressLocality: 'Wien',
      addressCountry: 'AT',
    },
    openingHoursSpecification: [
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '08:00', closes: '17:00' },
      { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '08:00', closes: '16:00' },
    ],
    url: 'https://alero.at/kontakt',
  })} />

  <script is:inline>
    // ── Google Maps click-to-load (DSGVO) ──────────────────────────────
    const mapBtn = document.getElementById('map-load');
    if (mapBtn) {
      mapBtn.addEventListener('click', () => {
        const ph = document.getElementById('map-placeholder');
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.google.com/maps?q=Dassanowskyweg%2016a%2C%201220%20Wien&output=embed';
        iframe.title = 'Karte: Dassanowskyweg 16a, 1220 Wien';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.style.width = '100%';
        iframe.style.height = '260px';
        iframe.style.border = '0';
        iframe.allowFullscreen = true;
        ph.replaceWith(iframe);
      });
    }

    // ── Web3Forms AJAX submit (progressive enhancement) ────────────────
    const form = document.getElementById('kontaktform');
    if (form) {
      const successBox = document.getElementById('form-success');
      const errorBox = document.getElementById('form-error');
      const submitBtn = form.querySelector('button[type="submit"]');
      const btnLabel = form.querySelector('.btn-label');
      const defaultLabel = btnLabel ? btnLabel.textContent : 'Nachricht senden';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        successBox.classList.add('hidden');
        errorBox.classList.add('hidden');
        submitBtn.disabled = true;
        if (btnLabel) btnLabel.textContent = 'Wird gesendet …';

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const json = await res.json();
          if (res.ok && json.success) {
            form.reset();
            const nk = document.getElementById('neukunde');
            if (nk) nk.checked = false;
            successBox.classList.remove('hidden');
            successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            throw new Error(json.message || 'submit failed');
          }
        } catch (err) {
          errorBox.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false;
          if (btnLabel) btnLabel.textContent = defaultLabel;
        }
      });
    }
  </script>
</Layout>
