---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBanner from '../components/StickyBanner.astro';
import AppPromo from '../components/AppPromo.astro';
import News from '../components/News.astro';
import Team from '../components/Team.astro';
import Reviews from '../components/Reviews.astro';
import html from '../raw/index.html?raw';
---
<Layout
  title="Alero Handels GmbH — Lebensmittel & Verpackung für Gastronomie in Wien"
  description="Seit 2009 beliefert Alero Restaurants, Hotels und Catering in Wien. Tiefkühlprodukte, Öle, Verpackung und Hygiene — bestellen Sie bequem in unserer App."
>
  <Header currentPath="/" />
  <Fragment set:html={html} />
  <Reviews />
  <Team />
  <News />
  <AppPromo />
  <Footer />
  <StickyBanner
    prefix="Frühlingsangebot:"
    message="Tiefkühlprodukte bis −20% — bis 30. April in der App"
  />
</Layout>