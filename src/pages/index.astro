---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSlider from '../components/HeroSlider.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import AppPromo from '../components/AppPromo.astro';
import NewsSection from '../components/NewsSection.astro';
import Footer from '../components/Footer.astro';
import { categories, heroSlides, news, stats } from '../data/home.js';
---

<BaseLayout
  title="Alero Handels GmbH | Grosshandel in Wien"
  description="Alero Handels GmbH: Lebensmittel, Tiefkühlprodukte, Verpackung, Grillbedarf und Gastro-Sortiment in Wien."
>
  <Header />
  <main>
    <HeroSlider slides={heroSlides} />
    <CategoryGrid categories={categories} />
    <AppPromo stats={stats} />
    <NewsSection news={news} />
  </main>
  <Footer />
</BaseLayout>
