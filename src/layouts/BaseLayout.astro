---
import '../styles.css';

const {
  title = 'Alero Handels GmbH',
  description = 'Grosshandel fuer Gastronomie, Handel und professionelle Kuechen in Wien.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-alero-paper text-alero-ink">
    <slot />
  </body>
</html>
