---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const navLinks = [
  { label: 'Startseite', href: '/' },
  { label: 'Über uns',   href: '/ueber-uns' },
  { label: 'Produkte',   href: '/produkte' },
  { label: 'Aktuelles',  href: '/aktuelles' },
  { label: 'Kontakt',    href: '/kontakt' },
];
---

<!-- TOP BAR -->
<div class="bg-[#f7f4ec] border-b border-line/70">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-4 md:py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <a href="/" class="flex items-center gap-5" aria-label="Alero Startseite">
      <img src="/assets/alero-logo-transparent-new.png" alt="Alero Handels GmbH" class="h-12 md:h-[54px] w-auto" width="216" height="54">
      <span class="hidden sm:flex items-center gap-3 text-[11px] uppercase tracking-[0.18em] text-ink/55">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-olive"></span>
        <span>Großhandel · B2B · Wien seit 2009</span>
      </span>
    </a>
    <div class="flex flex-wrap items-center gap-3 md:gap-6 text-[13px]">
      <a href="tel:+4317489520" class="group flex items-center gap-2.5 text-ink hover:text-olive transition">
        <span class="w-9 h-9 rounded-full bg-white border border-line flex items-center justify-center shadow-sm group-hover:bg-olive group-hover:border-olive transition">
          <svg class="w-4 h-4 text-olive group-hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        </span>
        <span class="tabular font-semibold">+43 1 748 95 20</span>
      </a>
      <a href="https://wa.me/4317489520" class="group flex items-center gap-2.5 text-ink hover:text-olive transition">
        <span class="w-9 h-9 rounded-full bg-white border border-line flex items-center justify-center shadow-sm group-hover:bg-olive group-hover:border-olive transition">
          <svg class="w-4 h-4 text-olive group-hover:text-white transition" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.86 11.86 0 0012.07 0C5.5 0 .16 5.34.16 11.91c0 2.1.55 4.16 1.6 5.97L0 24l6.28-1.65a11.87 11.87 0 005.79 1.48h.01c6.57 0 11.91-5.34 11.91-11.91 0-3.18-1.24-6.17-3.47-8.44zM12.08 21.8h-.01a9.9 9.9 0 01-5.05-1.38l-.36-.21-3.73.98 1-3.63-.24-.37a9.86 9.86 0 01-1.51-5.27c0-5.46 4.44-9.9 9.91-9.9 2.65 0 5.13 1.03 7 2.9a9.84 9.84 0 012.9 7c0 5.45-4.45 9.88-9.91 9.88zm5.43-7.39c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z"/></svg>
        </span>
        <span class="font-semibold">WhatsApp</span>
      </a>
    </div>
  </div>
</div>

<!-- NAVIGATION -->
<nav class="relative z-40 -mb-[30px] md:-mb-[38px]">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8">
    <div class="bg-inkdeep/95 shadow-2xl border border-white/10 px-5 md:px-8 py-4 md:py-5 flex items-center justify-between gap-6">
      <div class="hidden lg:flex items-center gap-2">
        {navLinks.map(({ label, href }) => (
          <a
            href={href}
            class:list={[
              'text-[14px] font-semibold px-4 py-2',
              currentPath === href ? 'text-olive relative' : 'text-white hover:text-olive transition',
            ]}
          >
            {label}
            {currentPath === href && <span class="absolute left-4 right-4 -bottom-1 h-px bg-olive"></span>}
          </a>
        ))}
      </div>
      <button class="lg:hidden text-white text-[13px] font-semibold uppercase tracking-[0.16em]">Menü</button>
      <a href="/app" class="group bg-olive hover:bg-leaf transition text-white text-[13px] font-semibold px-5 md:px-7 py-3 rounded-sm flex items-center gap-3 ml-auto">
        <span>App öffnen</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</nav>
