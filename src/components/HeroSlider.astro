---
const { slides } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-alero-dark text-white" data-hero-slider>
  <img
    data-hero-image
    class="absolute inset-0 h-full w-full scale-[1.02] object-cover opacity-70 transition duration-500"
    src={slides[0].image}
    alt=""
  />
  <div class="absolute inset-0 bg-gradient-to-r from-alero-dark via-alero-dark/85 to-alero-dark/35"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-alero-dark/40 via-transparent to-alero-dark/75"></div>

  <div class="relative mx-auto grid min-h-[620px] max-w-7xl content-center gap-12 px-4 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:px-8">
    <div class="max-w-2xl">
      <div class="mb-7 flex gap-2" aria-label="Slider Position" data-hero-dots>
        {slides.map((_, index) => (
          <button
            class:list={[
              'h-1 rounded-full transition',
              index === 0 ? 'w-16 bg-alero-gold' : 'w-10 bg-white/25 hover:bg-white/45',
            ]}
            type="button"
            aria-label={`Slide ${index + 1}`}
            data-hero-dot={index}
          />
        ))}
      </div>

      <p class="eyebrow" data-hero-eyebrow>{slides[0].eyebrow}</p>
      <h1 class="mt-5 font-display text-5xl font-bold leading-[0.95] tracking-tight text-white sm:text-6xl lg:text-7xl" data-hero-title>
        {slides[0].title}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-white/78" data-hero-text>{slides[0].text}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a class="btn-primary" href="/produkte/" data-hero-cta>{slides[0].cta}</a>
        <a class="btn-secondary" href="#app">Alero App</a>
      </div>
    </div>

    <div class="hidden items-end justify-end lg:flex">
      <div class="rounded-lg border border-white/15 bg-white/10 p-6 text-right backdrop-blur-md">
        <span class="font-display text-8xl font-bold leading-none text-alero-gold/80" data-hero-number>01</span>
        <p class="mt-3 max-w-xs text-sm leading-6 text-white/70">Aktuelle Highlights aus dem Alero Sortiment.</p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ slides }}>
  const root = document.querySelector('[data-hero-slider]');
  if (root) {
    const image = root.querySelector('[data-hero-image]');
    const eyebrow = root.querySelector('[data-hero-eyebrow]');
    const title = root.querySelector('[data-hero-title]');
    const text = root.querySelector('[data-hero-text]');
    const cta = root.querySelector('[data-hero-cta]');
    const number = root.querySelector('[data-hero-number]');
    const dots = [...root.querySelectorAll('[data-hero-dot]')];
    let current = 0;
    let timer;

    function showSlide(index) {
      current = (index + slides.length) % slides.length;
      const slide = slides[current];
      image.classList.add('opacity-0');
      window.setTimeout(() => {
        image.src = slide.image;
        image.classList.remove('opacity-0');
      }, 180);

      eyebrow.textContent = slide.eyebrow;
      title.textContent = slide.title;
      text.textContent = slide.text;
      cta.textContent = slide.cta;
      number.textContent = String(current + 1).padStart(2, '0');

      dots.forEach((dot, dotIndex) => {
        dot.className = dotIndex === current
          ? 'h-1 w-16 rounded-full bg-alero-gold transition'
          : 'h-1 w-10 rounded-full bg-white/25 transition hover:bg-white/45';
      });
    }

    function startTimer() {
      window.clearInterval(timer);
      timer = window.setInterval(() => showSlide(current + 1), 5200);
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        showSlide(index);
        startTimer();
      });
    });

    startTimer();
  }
</script>
