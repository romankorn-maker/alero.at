---
---

<section id="produkte" class="bg-paper">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-20 md:py-28">

    <header class="reveal text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-3 mb-5">
        <span class="w-8 h-px bg-olive"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] text-olive font-semibold">Unser Sortiment</span>
        <span class="w-8 h-px bg-olive"></span>
      </div>
      <h2 class="font-display font-bold text-4xl md:text-5xl text-ink leading-[1.05] mb-4">
        Acht Bereiche.<br>Ein Lieferant.
      </h2>
      <p class="text-ink/60 text-[15px] leading-relaxed">
        Tiefkühl-Klassiker, Speiseöle eigener Marke, Grillsortiment, Verpackung und Hygiene — alles aus einer Hand. Vollständiger Katalog mit Preisen in der Alero App. Bestellungen werden im Zentrallager Dassanowskyweg konfektioniert und in Wien innerhalb von 24 Stunden geliefert.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">

      <!-- Card 1 — Tiefkühlprodukte -->
      <a href="/produkte" class="prod-card group reveal bg-white border border-line rounded-sm p-7 flex flex-col">
        <div class="flex items-start justify-between mb-7">
          <div class="w-14 h-14 rounded-sm bg-gradient-to-br from-[#dbecfb] to-[#c8e0f5] flex items-center justify-center text-2xl">❄</div>
          <span class="font-display text-olive/40 text-sm tabular font-semibold">01</span>
        </div>
        <h3 class="font-display font-bold text-[20px] text-ink mb-2 leading-tight">Tiefkühl&shy;produkte</h3>
        <p class="text-[13px] text-ink/55 leading-relaxed mb-5 flex-1">McCain Pommes, Nuggets, Wedges, Onion Rings — friteusenfertige Klassiker.</p>
        <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
          Sortiment <span class="prod-arrow inline-block">→</span>
        </div>
      </a>

      <!-- Card 2 — Lebensmittel -->
      <a href="/produkte" class="prod-card group reveal bg-white border border-line rounded-sm p-7 flex flex-col" style="transition-delay:60ms">
        <div class="flex items-start justify-between mb-7">
          <div class="w-14 h-14 rounded-sm bg-gradient-to-br from-[#eaf3de] to-[#d8e8c4] flex items-center justify-center text-2xl">🥫</div>
          <span class="font-display text-olive/40 text-sm tabular font-semibold">02</span>
        </div>
        <h3 class="font-display font-bold text-[20px] text-ink mb-2 leading-tight">Lebensmittel</h3>
        <p class="text-[13px] text-ink/55 leading-relaxed mb-5 flex-1">Konserven, Saucen, Trockenwaren und Spezialitäten für Profiküchen.</p>
        <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
          Sortiment <span class="prod-arrow inline-block">→</span>
        </div>
      </a>

      <!-- Card 3 — Sonnenblumen- & Olivenöl (Eigenmarke!) -->
      <a href="/produkte" class="prod-card group reveal bg-white border-2 border-olive/30 rounded-sm p-7 flex flex-col relative overflow-hidden" style="transition-delay:120ms">
        <div class="absolute top-3 right-3 bg-olive text-white text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-sm">Eigenmarke</div>
        <div class="flex items-start justify-between mb-7">
          <div class="w-14 h-14 rounded-sm bg-gradient-to-br from-cream to-[#f3dcb5] flex items-center justify-center text-2xl">🌻</div>
          <span class="font-display text-olive/40 text-sm tabular font-semibold">03</span>
        </div>
        <h3 class="font-display font-bold text-[20px] text-ink mb-2 leading-tight">Sonnenblumen- & Olivenöl</h3>
        <p class="text-[13px] text-ink/55 leading-relaxed mb-5 flex-1"><strong class="text-ink">alero</strong> & Olio d'Oro — in 1 L, 5 L und 10 L Gebinden.</p>
        <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
          Sortiment <span class="prod-arrow inline-block">→</span>
        </div>
      </a>

      <!-- Card 4 — Holzkohle & Brennholz -->
      <a href="/produkte" class="prod-card group reveal bg-white border border-line rounded-sm p-7 flex flex-col" style="transition-delay:180ms">
        <div class="flex items-start justify-between mb-7">
          <div class="w-14 h-14 rounded-sm bg-gradient-to-br from-[#faece7] to-[#f3d4c8] flex items-center justify-center text-2xl">🔥</div>
          <span class="font-display text-olive/40 text-sm tabular font-semibold">04</span>
        </div>
        <h3 class="font-display font-bold text-[20px] text-ink mb-2 leading-tight">Holzkohle & Brennholz</h3>
        <p class="text-[13px] text-ink/55 leading-relaxed mb-5 flex-1">Restaurant-Holzkohle 10 kg, Brennholz Buche, Kamado-Grills.</p>
        <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
          Sortiment <span class="prod-arrow inline-block">→</span>
        </div>
      </a>

      <!-- Card 5 — Styropor Verpackung -->
      <a href="/produkte" class="prod-card group reveal bg-white border border-line rounded-sm p-7 flex flex-col">
        <div class="flex items-start justify-between mb-7">
          <div class="w-14 h-14 rounded-sm bg-gradient-to-br from-[#eeedfe] to-[#dbd9f5] flex items-center justify-center text-2xl">🥡</div>
          <span class="font-display text-olive/40 text-sm tabular font-semibold">05</span>
        </div>
        <h3 class="font-display font-bold text-[20px] text-ink mb-2 leading-tight">Styropor Verpackung</h3>
        <p class="text-[13px] text-ink/55 leading-relaxed mb-5 flex-1">Take-away Boxen, Klappschalen, verschiedene Formate.</p>
        <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
          Sortiment <span class="prod-arrow inline-block">→</span>
        </div>
      </a>

      <!-- Card 6 — Salat- & Feinkost-Boxen (PP) -->
      <a href="/produkte" class="prod-card group reveal bg-white border border-line rounded-sm p-7 flex flex-col" style="transition-delay:60ms">
        <div class="flex items-start justify-between mb-7">
          <div class="w-14 h-14 rounded-sm bg-gradient-to-br from-[#e1f5ee] to-[#c8ead9] flex items-center justify-center text-2xl">🥗</div>
          <span class="font-display text-olive/40 text-sm tabular font-semibold">06</span>
        </div>
        <h3 class="font-display font-bold text-[20px] text-ink mb-2 leading-tight">Salat- & Feinkost-Boxen</h3>
        <p class="text-[13px] text-ink/55 leading-relaxed mb-5 flex-1">PP-Behälter mit Deckel für Salat, Feinkost, Catering.</p>
        <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
          Sortiment <span class="prod-arrow inline-block">→</span>
        </div>
      </a>

      <!-- Card 7 — Papier & Karton -->
      <a href="/produkte" class="prod-card group reveal bg-white border border-line rounded-sm p-7 flex flex-col" style="transition-delay:120ms">
        <div class="flex items-start justify-between mb-7">
          <div class="w-14 h-14 rounded-sm bg-gradient-to-br from-cream to-[#f3dcb5] flex items-center justify-center text-2xl">☕</div>
          <span class="font-display text-olive/40 text-sm tabular font-semibold">07</span>
        </div>
        <h3 class="font-display font-bold text-[20px] text-ink mb-2 leading-tight">Papier & Karton</h3>
        <p class="text-[13px] text-ink/55 leading-relaxed mb-5 flex-1">Kaffeebecher, Kraftboxen, Papiertaschen — Standard und mit Logo.</p>
        <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
          Sortiment <span class="prod-arrow inline-block">→</span>
        </div>
      </a>

      <!-- Card 8 — Alu Verpackung -->
      <a href="/produkte" class="prod-card group reveal bg-white border border-line rounded-sm p-7 flex flex-col" style="transition-delay:180ms">
        <div class="flex items-start justify-between mb-7">
          <div class="w-14 h-14 rounded-sm bg-gradient-to-br from-[#e5e5e5] to-[#cccccc] flex items-center justify-center text-2xl">🍱</div>
          <span class="font-display text-olive/40 text-sm tabular font-semibold">08</span>
        </div>
        <h3 class="font-display font-bold text-[20px] text-ink mb-2 leading-tight">Alu Verpackung</h3>
        <p class="text-[13px] text-ink/55 leading-relaxed mb-5 flex-1">Alu-Schalen, Deckel und verschiedene Formate für Catering.</p>
        <div class="flex items-center gap-2 text-[12px] font-semibold text-olive uppercase tracking-wider">
          Sortiment <span class="prod-arrow inline-block">→</span>
        </div>
      </a>

    </div>

    <!-- App callout under grid -->
    <div class="reveal mt-12 flex flex-wrap items-center justify-between gap-6 bg-ink rounded-sm p-6 md:p-8 relative overflow-hidden">
      <div class="absolute right-0 top-0 bottom-0 w-1/2 opacity-[0.04] pointer-events-none" style="background: radial-gradient(circle at center, #3DA84F 0%, transparent 60%);"></div>
      <div class="relative z-10">
        <div class="text-[11px] uppercase tracking-[0.25em] text-olive font-semibold mb-2">Vollständiger Katalog</div>
        <div class="font-display font-bold text-white text-2xl md:text-[28px] leading-tight">Alle Produkte, Preise und Verfügbarkeiten in der App</div>
      </div>
      <a href="#app" class="relative z-10 bg-white text-ink hover:bg-olive hover:text-white transition font-semibold px-6 py-3.5 rounded-sm text-[13px] flex items-center gap-2 whitespace-nowrap">
        App öffnen
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>
