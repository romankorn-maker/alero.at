---
interface Props {
  variant?: 'home' | 'page';
}
const { variant = 'home' } = Astro.props;
---

<section id="ueber-uns" class="bg-[#efeae0] relative overflow-hidden">
  <!-- subtle pattern -->
  <div class="absolute inset-0 opacity-[0.4] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, rgba(26,16,8,0.06) 1px, transparent 0); background-size: 24px 24px;"></div>

  <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-20 md:py-28 relative z-10 grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">

    <!-- Left visual -->
    <div class="reveal lg:col-span-5 relative">
      <!-- mock photo -->
      <div class="aspect-[4/5] relative rounded-sm overflow-hidden bg-ink">
        <img src="/assets/alero-warehouse.webp" alt="Alero Zentrallager in Wien" class="absolute inset-0 w-full h-full object-cover">
        <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(26,16,8,0.04) 0%, rgba(26,16,8,0.18) 45%, rgba(26,16,8,0.74) 100%);"></div>        <!-- caption overlay -->
        <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
          <div class="text-[10px] uppercase tracking-[0.2em] text-olive font-semibold mb-1">Zentrallager</div>
          <div class="font-display text-lg leading-tight">Dassanowskyweg 16a<br>1220 Wien</div>
        </div>
      </div>

      <!-- floating badge -->
      <div class="hidden md:block absolute -bottom-6 -right-6 bg-olive text-white rounded-sm p-5 shadow-card-hover">
        <div class="font-display text-[40px] leading-none font-bold tabular">15<span class="text-2xl align-top ml-1">+</span></div>
        <div class="text-[10px] uppercase tracking-[0.15em] mt-1">Jahre in Wien</div>
      </div>
    </div>

    <!-- Right content -->
    <div class="lg:col-span-7">
      <div class="reveal">
        <div class="inline-flex items-center gap-2.5 mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-olive"></span>
          <span class="text-[11px] uppercase tracking-[0.25em] text-olive font-semibold">Über Alero · seit 2009</span>
        </div>
        <h2 class="font-display font-bold text-4xl md:text-[52px] text-ink leading-[1.02] mb-7">
          Der Wiener Lieferant für <span class="font-serif italic font-normal text-olive">Gastronomie</span> & Imbisse
        </h2>
        <p class="text-ink/65 text-[16px] leading-[1.75] mb-9 max-w-[58ch]">
          Alero Handels GmbH beliefert seit über fünfzehn Jahren Restaurants, Imbisse und Catering-Betriebe in Wien. Tiefkühl-Klassiker namhafter Marken wie <strong class="text-ink">McCain</strong>, Sonnenblumenöl unter unserer <strong class="text-ink">eigenen Marke alero</strong>, ein komplettes Grillsortiment mit Holzkohle und Brennholz, plus Verpackung für jeden Take-away-Bedarf — alles aus einer Hand.
        </p>

        <ul class="space-y-4 mb-10">
          <li class="reveal flex items-start gap-4">
            <span class="flex-shrink-0 mt-1 w-6 h-6 rounded-full bg-olive/10 flex items-center justify-center">
              <svg class="w-3 h-3 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <div class="text-[14px] text-ink/80 leading-relaxed"><strong class="font-semibold text-ink">Eigenes Zentrallager</strong> · Dassanowskyweg 16a, 1220 Wien — kein Drittlager, keine versteckten Wege.</div>
          </li>
          <li class="reveal flex items-start gap-4" style="transition-delay:80ms">
            <span class="flex-shrink-0 mt-1 w-6 h-6 rounded-full bg-olive/10 flex items-center justify-center">
              <svg class="w-3 h-3 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <div class="text-[14px] text-ink/80 leading-relaxed"><strong class="font-semibold text-ink">Lieferung innerhalb 24 Stunden</strong> nach Bestellung in der Alero App, Wien und Umgebung.</div>
          </li>
          <li class="reveal flex items-start gap-4" style="transition-delay:160ms">
            <span class="flex-shrink-0 mt-1 w-6 h-6 rounded-full bg-olive/10 flex items-center justify-center">
              <svg class="w-3 h-3 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <div class="text-[14px] text-ink/80 leading-relaxed"><strong class="font-semibold text-ink">B2B-Sortiment</strong> · Restaurants, Hotels, Catering, Imbisse — Großgebinde und Profi-Mengen.</div>
          </li>
        </ul>

        {variant !== 'page' && (
          <a href="/ueber-uns" class="inline-flex items-center gap-3 text-olive hover:text-ink transition font-semibold text-[14px] border-b-2 border-olive hover:border-ink pb-1">
            Mehr über uns erfahren
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        )}

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4 md:gap-8 mt-12 pt-10 border-t border-ink/10">
          <div class="reveal">
            <div class="font-display font-bold text-[44px] md:text-[56px] text-olive leading-none tabular">24<span class="text-2xl align-top">h</span></div>
            <div class="text-[11px] uppercase tracking-[0.15em] text-ink/50 mt-2 font-semibold">Lieferung</div>
          </div>
          <div class="reveal" style="transition-delay:100ms">
            <div class="font-display font-bold text-[44px] md:text-[56px] text-olive leading-none tabular">600<span class="text-2xl align-top">+</span></div>
            <div class="text-[11px] uppercase tracking-[0.15em] text-ink/50 mt-2 font-semibold">Kunden in Wien</div>
          </div>
          <div class="reveal" style="transition-delay:200ms">
            <div class="font-display font-bold text-[44px] md:text-[56px] text-olive leading-none tabular">8</div>
            <div class="text-[11px] uppercase tracking-[0.15em] text-ink/50 mt-2 font-semibold">Produktbereiche</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
