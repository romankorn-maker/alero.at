---
interface Props {
  prefix?: string;
  message: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  prefix,
  message,
  ctaLabel = 'App öffnen →',
  ctaHref = '#app-download',
} = Astro.props;
---

<div id="sticky-banner" class="sticky-banner fixed bottom-0 left-0 right-0 bg-olive text-white z-30 shadow-2xl">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-3 flex items-center justify-between gap-4">
    <div class="text-[13px] flex items-center gap-3">
      <span class="hidden md:inline-flex w-2 h-2 rounded-full bg-white animate-pulse"></span>
      <span>
        {prefix && <strong class="font-semibold">{prefix} </strong>}
        {message}
      </span>
    </div>
    <div class="flex items-center gap-4">
      <a href={ctaHref} class="bg-white text-olive font-semibold px-4 py-1.5 rounded-sm text-[12px] hover:bg-ink hover:text-white transition whitespace-nowrap">{ctaLabel}</a>
      <button id="sticky-close" class="text-white/70 hover:text-white text-xl leading-none" aria-label="Schließen">×</button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('sticky-banner');
  const bannerClose = document.getElementById('sticky-close');
  bannerClose?.addEventListener('click', () => banner?.classList.add('hide'));
</script>
