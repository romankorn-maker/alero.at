---

---

<footer class="bg-inkdeep text-white">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8 pt-20 pb-10">

    <div class="grid md:grid-cols-12 gap-10 md:gap-8 pb-14 border-b border-white/10">

      <!-- Brand & address -->
      <div class="md:col-span-5">
        <div class="mb-6">
          <img src="/assets/alero-logo-white.png" alt="Alero Handels GmbH" class="h-12 w-auto">
        </div>
        <address class="not-italic text-white/65 text-[14px] leading-[1.85]">
          Dassanowskyweg 16a<br>
          1220 Wien, Österreich<br>
          <a href="tel:+4317489520" class="text-olive hover:text-leaf transition tabular">+43 1 748 95 20</a><br>
          <a href="mailto:office@alero.at" class="text-olive hover:text-leaf transition">office@alero.at</a>
        </address>
        <div class="mt-6 inline-flex flex-col gap-1 text-[12px] text-white/50">
          <div class="flex items-center gap-3">
            <span class="text-white/70 font-semibold">Mo–Do</span>
            <span class="tabular">8:00 – 17:00</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-white/70 font-semibold">Freitag</span>
            <span class="tabular">8:00 – 16:00</span>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-3">
        <div class="text-[11px] uppercase tracking-[0.2em] text-olive font-semibold mb-5">Navigation</div>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href="/" class="text-white/65 hover:text-white transition">Startseite</a></li>
          <li><a href="/ueber-uns" class="text-white/65 hover:text-white transition">Über uns</a></li>
          <li><a href="/produkte" class="text-white/65 hover:text-white transition">Produkte</a></li>
          <li><a href="/aktuelles" class="text-white/65 hover:text-white transition">Aktuelles</a></li>
          <li><a href="/kontakt" class="text-white/65 hover:text-white transition">Kontakt</a></li>
        </ul>
      </div>

      <!-- App -->
      <div id="app-download" class="md:col-span-4 scroll-mt-28">
        <div class="text-[11px] uppercase tracking-[0.2em] text-olive font-semibold mb-5">App herunterladen</div>
        <div class="flex flex-col gap-2.5">
          <a href="https://apps.apple.com/ie/app/alero-handel-gmbh/id6758994958" target="_blank" rel="noopener" class="bg-white/[0.06] hover:bg-white/[0.1] border border-white/10 rounded-sm px-4 py-3 flex items-center gap-3 transition">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            <span class="text-[13px] text-white/85">App Store · iOS</span>
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.goodbarber.alero&hl=de" target="_blank" rel="noopener" class="bg-white/[0.06] hover:bg-white/[0.1] border border-white/10 rounded-sm px-4 py-3 flex items-center gap-3 transition">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 23.76c.3.17.64.24.99.18l12.45-7.2-2.63-2.63-10.81 9.65zm-1.97-20.8C.84 3.4.5 3.9.5 4.56v14.88c0 .66.34 1.16.71 1.6l.08.08 8.34-8.34v-.2L1.21 2.96zm17.54 8.04l-2.49-1.44-2.92 2.92 2.92 2.92 2.51-1.45c.72-.41.72-1.54-.02-1.95zM4.17.25l12.45 7.2-2.63 2.63L3.18.43C3.48.26 3.87.08 4.17.25z"/></svg>
            <span class="text-[13px] text-white/85">Google Play · Android</span>
          </a>
        </div>
      </div>

    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 pt-8 text-[12px] text-white/40">
      <div>© {new Date().getFullYear()} Alero Handels GmbH · Alle Rechte vorbehalten</div>
      <div class="flex items-center gap-6">
        <a href="/impressum" class="hover:text-white transition">Impressum</a>
        <a href="/datenschutz" class="hover:text-white transition">Datenschutzerklärung</a>
        <a href="/agb" class="hover:text-white transition">AGB</a>
      </div>
    </div>
  </div>
</footer>
