---
---

<section id="aktionen" class="bg-[#efeae0]">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-20 md:py-28">

    <header class="reveal flex flex-wrap items-end justify-between gap-6 mb-14">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2.5 mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-olive"></span>
          <span class="text-[11px] uppercase tracking-[0.25em] text-olive font-semibold">Aktionen & Neuigkeiten</span>
        </div>
        <h2 class="font-display font-bold text-4xl md:text-5xl text-ink leading-[1.05]">
          Sonderangebote, neue Produkte und nützliche Tipps für Ihren Betrieb
        </h2>
      </div>
      <a href="/aktuelles" class="text-olive hover:text-ink transition font-semibold text-[14px] border-b-2 border-olive hover:border-ink pb-1 flex items-center gap-2">
        Alle Beiträge ansehen →
      </a>
    </header>

    <div class="grid md:grid-cols-3 gap-5">

      <article class="reveal group bg-white border border-line rounded-sm overflow-hidden flex flex-col">
        <div class="aspect-[3/2] relative overflow-hidden" style="background: linear-gradient(135deg, #c8e0f5 0%, #6a8fb8 50%, #2e4a66 100%);">
          <div class="absolute inset-0 flex items-center justify-center text-[80px] opacity-50">❄</div>
          <span class="absolute top-3 left-3 bg-olive text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-sm">Aktion</span>
          <span class="absolute bottom-3 right-3 bg-white/90 backdrop-blur text-ink font-display font-bold px-3 py-1 text-base">−20%</span>
        </div>
        <div class="p-6 flex-1 flex flex-col">
          <div class="text-[11px] uppercase tracking-[0.15em] text-ink/40 font-semibold mb-3">April 2026</div>
          <h3 class="font-display font-bold text-xl text-ink leading-tight mb-3 flex-1">Tiefkühlprodukte bis −20% — Frühlingsangebot bis Ende April</h3>
          <span class="text-[12px] font-semibold text-olive">Weiterlesen →</span>
        </div>
      </article>

      <article class="reveal group bg-white border border-line rounded-sm overflow-hidden flex flex-col" style="transition-delay:100ms">
        <div class="aspect-[3/2] relative overflow-hidden" style="background: linear-gradient(135deg, #f3dcb5 0%, #6dc878 50%, #1f5e2a 100%);">
          <div class="absolute inset-0 flex items-center justify-center text-[80px] opacity-50">🌻</div>
          <span class="absolute top-3 left-3 bg-ink text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-sm">Sortiment</span>
        </div>
        <div class="p-6 flex-1 flex flex-col">
          <div class="text-[11px] uppercase tracking-[0.15em] text-ink/40 font-semibold mb-3">März 2026</div>
          <h3 class="font-display font-bold text-xl text-ink leading-tight mb-3 flex-1">Neues Sonnenblumenöl im Sortiment: drei Gebindegrößen für Gastronomie</h3>
          <span class="text-[12px] font-semibold text-olive">Weiterlesen →</span>
        </div>
      </article>

      <article class="reveal group bg-white border border-line rounded-sm overflow-hidden flex flex-col" style="transition-delay:200ms">
        <div class="aspect-[3/2] relative overflow-hidden" style="background: linear-gradient(135deg, #c8ead9 0%, #5a8a72 50%, #2e4a3a 100%);">
          <div class="absolute inset-0 flex items-center justify-center text-[80px] opacity-50">📦</div>
          <span class="absolute top-3 left-3 bg-white text-ink text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-sm">Tipps</span>
        </div>
        <div class="p-6 flex-1 flex flex-col">
          <div class="text-[11px] uppercase tracking-[0.15em] text-ink/40 font-semibold mb-3">Februar 2026</div>
          <h3 class="font-display font-bold text-xl text-ink leading-tight mb-3 flex-1">Wie lagert man Tiefkühlprodukte richtig? Tipps für Restaurantküchen</h3>
          <span class="text-[12px] font-semibold text-olive">Weiterlesen →</span>
        </div>
      </article>

    </div>
  </div>
</section>
