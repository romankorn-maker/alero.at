<script is:inline>
  // Ã¢â€â‚¬Ã¢â€â‚¬ Hero slider data Ã¢â€â‚¬Ã¢â€â‚¬
  // Slide 0 Ã¢â‚¬â€ Aktion (variable, monthly): change copy & ghost as needed
  // Slides 1-3 Ã¢â‚¬â€ permanent: Ãƒâ€"l (branded), Grillen (seasonal), TiefkÃƒÂ¼hl-Klassiker
  const slidesData = [
    { tag: 'Aktion &middot; Tiefk&uuml;hl &middot; sofort lieferbar', titleA: 'Tiefk&uuml;hlprodukte', titleB: 'f&uuml;r Gastro & Handel', desc: 'Pommes, Wedges und weitere Tiefk&uuml;hl-Klassiker f&uuml;r die professionelle K&uuml;che. Bestellen Sie schnell und planbar in der Alero App.', cta: 'Tiefk&uuml;hl in der App ansehen', ghost: '01', bannerImage: 'assets/tiefkuehl-produkte.webp' },
    { tag: 'Eigenmarke &middot; Sonnenblumen&ouml;l', titleA: 'Alero Sonnenblumen&ouml;l', titleB: 'f&uuml;r die Profik&uuml;che', desc: 'Sonnenblumen&ouml;l unter eigener Marke in praktischen Gebindegr&ouml;&szlig;en. Verl&auml;sslich verf&uuml;gbar f&uuml;r Gastronomie, Catering und Handel.', cta: 'Zum &Ouml;l-Sortiment', ghost: '02', bannerImage: 'assets/sonnenblumenoel.webp' },
    { tag: 'Saison &middot; Grillen & Holzkohle', titleA: 'Grillen, Holzkohle', titleB: 'und Brennholz', desc: 'Holzkohle, Grillzubeh&ouml;r und Brennholz f&uuml;r Gastronomie und Sommergesch&auml;ft. Direkt aus dem Lager in Wien verf&uuml;gbar.', cta: 'Grillsortiment ansehen', ghost: '03', bannerImage: 'assets/grillen-holzkohle.webp' },
    { tag: 'Klassiker &middot; Snacks & Beilagen', titleA: 'Nuggets, Wedges', titleB: 'Onion Rings & Co.', desc: 'Friteusenfertige Klassiker f&uuml;r schnelle Abl&auml;ufe: Snacks, Beilagen und Fingerfood in gro&szlig;en Gebinden f&uuml;r Profik&uuml;chen.', cta: 'Snacks in der App ansehen', ghost: '04', bannerImage: 'assets/nuggets-wedges-onion-rings.webp' },
  ];

  let current = 0;
  let timer = null;
  const slidesContainer = document.getElementById('slides');
  const slideCurrent = document.getElementById('slide-current');
  const inds = document.querySelectorAll('.slide-ind');
  const ghostEl = document.querySelector('.hero-ghost-num');
  const heroBannerImage = document.getElementById('hero-banner-image');

  function setHeroImage(src) {
    if (!heroBannerImage || heroBannerImage.getAttribute('src') === src) return;
    heroBannerImage.classList.add('is-changing');
    window.setTimeout(() => { heroBannerImage.src = src; heroBannerImage.classList.remove('is-changing'); }, 220);
  }

  function renderSlide(i) {
    const s = slidesData[i];
    setHeroImage(s.bannerImage);
    slidesContainer.innerHTML = `
      <article class="slide relative max-w-[760px]" data-slide="${i}" style="opacity:0; transform:translateY(12px); transition:opacity .6s, transform .6s;">
        <div class="inline-flex items-center gap-2.5 bg-olive/20 border border-olive/40 text-olive text-[11px] font-semibold uppercase tracking-[0.15em] px-3 py-1.5 rounded-sm mb-6 backdrop-blur-sm">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-olive animate-pulse"></span>${s.tag}
        </div>
        <h1 class="font-display font-bold text-white text-[54px] md:text-[82px] leading-[0.92] tracking-[-0.01em] max-w-[15ch] mb-7 relative z-10">${s.titleA}<br><span class="text-olive">${s.titleB}</span></h1>
        <p class="font-serif italic text-white text-[17px] md:text-[20px] leading-relaxed max-w-[44ch] mb-10 relative z-10" style="text-shadow:0 3px 18px rgba(0,0,0,0.55);">${s.desc}</p>
        <div class="flex flex-wrap items-center gap-4 relative z-10">
          <a href="#app" class="group bg-olive hover:bg-leaf transition text-white font-semibold px-7 py-4 rounded-sm flex items-center gap-3 text-[14px]">${s.cta}<svg class="w-4 h-4 group-hover:translate-x-1 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href="#produkte" class="text-white/80 hover:text-white text-[13px] font-medium tracking-wide flex items-center gap-2 border-b border-white/25 hover:border-white/70 pb-1 transition">Sortiment ansehen</a>
        </div>
      </article>`;
    requestAnimationFrame(() => { const a = slidesContainer.querySelector('.slide'); a.style.opacity = '1'; a.style.transform = 'translateY(0)'; });
    ghostEl.textContent = s.ghost;
    inds.forEach((ind, idx) => { ind.style.width = idx === i ? '64px' : '40px'; ind.style.background = idx === i ? '#3DA84F' : 'rgba(255,255,255,0.18)'; });
    slideCurrent.textContent = String(i + 1).padStart(2, '0');
  }

  function go(i) { current = ((i % slidesData.length) + slidesData.length) % slidesData.length; renderSlide(current); resetTimer(); }
  function resetTimer() { if (timer) clearInterval(timer); timer = setInterval(() => go(current + 1), 6500); }
  document.querySelectorAll('.slide-btn').forEach(btn => btn.addEventListener('click', () => go(parseInt(btn.dataset.go, 10))));
  renderSlide(0);
  resetTimer();
</script>
