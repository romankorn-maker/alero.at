---
const { categories } = Astro.props;
---

<section class="section">
  <div class="section-heading">
    <p class="eyebrow">Sortiment</p>
    <h2 class="section-title">Alles für Gastronomie, Handel und Profiküche</h2>
    <p class="section-subtitle">Die wichtigsten Bereiche sind bewusst nah an der Bestellung gedacht: schnell erfassbar, klar bebildert und später leicht in einzelne Produktseiten erweiterbar.</p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {categories.map((category) => (
      <article class="overflow-hidden rounded-lg border border-alero-line bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
        <img class="h-48 w-full object-cover" src={category.image} alt="" loading="lazy" />
        <div class="p-6">
          <h3 class="font-display text-2xl font-bold text-alero-dark">{category.title}</h3>
          <p class="mt-3 text-sm leading-6 text-alero-muted">{category.text}</p>
        </div>
      </article>
    ))}
  </div>
</section>
