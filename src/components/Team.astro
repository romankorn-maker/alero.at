---
---

<section class="bg-paper">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-20 md:py-28">

    <header class="reveal max-w-2xl mb-14">
      <div class="inline-flex items-center gap-2.5 mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-olive"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] text-olive font-semibold">Unser Team</span>
      </div>
      <h2 class="font-display font-bold text-4xl md:text-5xl text-ink leading-[1.05] mb-3">
        Ihre persönlichen Ansprechpartner
      </h2>
      <p class="text-ink/60 text-[15px]">Keine Hotline, keine Wartezeiten — Sie sprechen direkt mit den Menschen, die Ihre Bestellung kennen.</p>
    </header>

    <div class="grid md:grid-cols-3 gap-5">

      <article class="reveal group bg-white border border-line rounded-sm overflow-hidden">
        <div class="aspect-[4/3] relative overflow-hidden" style="background: linear-gradient(135deg, #f3dcb5 0%, #6dc878 100%);">
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="font-display font-bold text-white text-[120px] opacity-30 leading-none">MH</span>
          </div>
          <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur px-2.5 py-1 rounded-sm text-[10px] uppercase tracking-wider font-semibold text-ink">Geschäftsführer</div>
        </div>
        <div class="p-6">
          <h3 class="font-display font-bold text-xl text-ink mb-1">Michael H.</h3>
          <p class="text-[13px] text-ink/55 mb-4">Strategie, Partnerschaften, Verträge</p>
          <a href="mailto:michael@alero.at" class="text-[12px] font-semibold text-olive hover:text-ink transition flex items-center gap-1.5">
            michael@alero.at →
          </a>
        </div>
      </article>

      <article class="reveal group bg-white border border-line rounded-sm overflow-hidden" style="transition-delay:100ms">
        <div class="aspect-[4/3] relative overflow-hidden" style="background: linear-gradient(135deg, #c8e0f5 0%, #6a8fb8 100%);">
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="font-display font-bold text-white text-[120px] opacity-30 leading-none">AK</span>
          </div>
          <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur px-2.5 py-1 rounded-sm text-[10px] uppercase tracking-wider font-semibold text-ink">Kundenbetreuung</div>
        </div>
        <div class="p-6">
          <h3 class="font-display font-bold text-xl text-ink mb-1">Anna K.</h3>
          <p class="text-[13px] text-ink/55 mb-4">Erste Ansprechpartnerin für Neu- und Stammkunden</p>
          <a href="mailto:anna@alero.at" class="text-[12px] font-semibold text-olive hover:text-ink transition flex items-center gap-1.5">
            anna@alero.at →
          </a>
        </div>
      </article>

      <article class="reveal group bg-white border border-line rounded-sm overflow-hidden" style="transition-delay:200ms">
        <div class="aspect-[4/3] relative overflow-hidden" style="background: linear-gradient(135deg, #c8ead9 0%, #5a8a72 100%);">
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="font-display font-bold text-white text-[120px] opacity-30 leading-none">TW</span>
          </div>
          <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur px-2.5 py-1 rounded-sm text-[10px] uppercase tracking-wider font-semibold text-ink">Logistik & Lager</div>
        </div>
        <div class="p-6">
          <h3 class="font-display font-bold text-xl text-ink mb-1">Thomas W.</h3>
          <p class="text-[13px] text-ink/55 mb-4">Bestellungen, Lieferplanung, Lagerbestand</p>
          <a href="mailto:thomas@alero.at" class="text-[12px] font-semibold text-olive hover:text-ink transition flex items-center gap-1.5">
            thomas@alero.at →
          </a>
        </div>
      </article>

    </div>
  </div>
</section>
