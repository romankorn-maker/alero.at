---
---

<section id="app" class="relative overflow-hidden" style="background: linear-gradient(135deg, #3DA84F 0%, #1f5e2a 100%);">
  <!-- decorative pattern -->
  <div class="absolute inset-0 opacity-[0.08] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"></div>

  <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-20 md:py-24 relative z-10 grid lg:grid-cols-2 gap-12 items-center">

    <div class="reveal">
      <div class="inline-flex items-center gap-2.5 mb-5 text-white">
        <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] font-semibold">Alero Mobile App</span>
      </div>
      <h2 class="font-display font-bold text-white text-4xl md:text-[56px] leading-[1.02] mb-6">
        Bestellen Sie in<br>
        <span class="font-serif italic font-normal">wenigen Klicks</span>
      </h2>
      <p class="text-white/85 text-[16px] leading-relaxed mb-9 max-w-[48ch]">
        Vollständiger Katalog, Bestellhistorie, Lieferverfolgung und schnelles Nachbestellen Ihrer Standardartikel — alles in der Alero App für iOS und Android.
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="https://apps.apple.com/ie/app/alero-handel-gmbh/id6758994958" target="_blank" rel="noopener" class="group bg-ink hover:bg-inkdeep transition text-white px-5 py-3 rounded-sm flex items-center gap-3">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          <div class="text-left">
            <div class="text-[10px] uppercase tracking-wider opacity-70">Download im</div>
            <div class="font-semibold text-base leading-tight">App Store</div>
          </div>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.goodbarber.alero&hl=de" target="_blank" rel="noopener" class="group bg-ink hover:bg-inkdeep transition text-white px-5 py-3 rounded-sm flex items-center gap-3">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 23.76c.3.17.64.24.99.18l12.45-7.2-2.63-2.63-10.81 9.65zm-1.97-20.8C.84 3.4.5 3.9.5 4.56v14.88c0 .66.34 1.16.71 1.6l.08.08 8.34-8.34v-.2L1.21 2.96zm17.54 8.04l-2.49-1.44-2.92 2.92 2.92 2.92 2.51-1.45c.72-.41.72-1.54-.02-1.95zM4.17.25l12.45 7.2-2.63 2.63L3.18.43C3.48.26 3.87.08 4.17.25z"/></svg>
          <div class="text-left">
            <div class="text-[10px] uppercase tracking-wider opacity-70">Erhältlich bei</div>
            <div class="font-semibold text-base leading-tight">Google Play</div>
          </div>
        </a>
      </div>
    </div>

    <!-- App visuals -->
    <div class="reveal flex justify-center lg:justify-end gap-4 md:gap-6">
      <div class="w-44 md:w-52 aspect-[9/19] bg-inkdeep rounded-[28px] p-2 shadow-2xl transform -rotate-6 translate-y-4">
        <div class="w-full h-full rounded-[22px] bg-gradient-to-br from-white via-[#eef8f1] to-[#39a64c] relative overflow-hidden flex flex-col items-center justify-center px-5 text-center">
          <div class="absolute top-2 left-1/2 -translate-x-1/2 w-16 h-4 bg-inkdeep rounded-full z-10"></div>
          <div class="absolute -right-10 -top-10 w-32 h-32 rounded-full border-[18px] border-white/35"></div>
          <div class="absolute -right-16 bottom-10 w-48 h-48 rounded-full border-[28px] border-olive/25"></div>
          <img src="assets/alero-logo-transparent-new.png" alt="Alero" class="relative z-10 h-12 w-auto mb-4">
          <p class="relative z-10 text-[9px] font-semibold text-ink/80 mb-6">Ihr Partner für Hotel, Gastronomie und Catering</p>
          <span class="relative z-10 border border-olive rounded-full px-5 py-2 text-[9px] font-semibold text-olive bg-white/65">JETZT BESTELLEN</span>
          <div class="absolute left-5 right-5 bottom-8 text-[7px] leading-relaxed text-ink/65">
            DASSANOWSKYWEG 16A · 1220 WIEN<br>Tel. +43 1 748 95 20
          </div>
        </div>
      </div>
      <div class="w-44 md:w-52 aspect-[9/19] bg-inkdeep rounded-[28px] p-2 shadow-2xl transform rotate-3 -translate-y-2">
        <div class="w-full h-full rounded-[22px] bg-paper relative overflow-hidden flex flex-col">
          <div class="absolute top-2 left-1/2 -translate-x-1/2 w-16 h-4 bg-inkdeep rounded-full z-10"></div>
          <div class="pt-9 px-3 pb-3 bg-white border-b border-line flex items-center justify-between"><img src="assets/alero-logo-transparent-new.png" alt="Alero" class="h-7 w-auto"><div class="w-8 h-8 rounded-full bg-olive/10 flex items-center justify-center text-olive font-bold text-[11px]">12</div></div>
          <div class="p-3 space-y-2 overflow-hidden">
            <div class="relative h-24 rounded overflow-hidden"><img src="assets/tiefkuehl-produkte.webp" alt="Tiefkühlprodukte" class="w-full h-full object-cover"><div class="absolute inset-0 bg-gradient-to-t from-inkdeep/70 to-transparent"></div><div class="absolute left-3 bottom-2 text-white font-display font-bold text-lg leading-none">Tiefkühl</div></div>
            <div class="bg-white border border-line rounded p-2 flex items-center gap-2"><img src="assets/sonnenblumenoel.webp" alt="Alero Sonnenblumenöl" class="w-9 h-9 rounded object-cover"><div class="flex-1"><div class="text-[8px] font-semibold text-ink">Sonnenblumenöl</div><div class="text-[7px] text-ink/40">Eigenmarke Alero</div></div></div>
            <div class="bg-white border border-line rounded p-2 flex items-center gap-2"><img src="assets/grillen-holzkohle.webp" alt="Grillen und Holzkohle" class="w-9 h-9 rounded object-cover"><div class="flex-1"><div class="text-[8px] font-semibold text-ink">Grillen</div><div class="text-[7px] text-ink/40">Holzkohle & Zubehör</div></div></div>
            <div class="bg-white border border-line rounded p-2 flex items-center gap-2"><img src="assets/nuggets-wedges-onion-rings.webp" alt="Nuggets und Wedges" class="w-9 h-9 rounded object-cover"><div class="flex-1"><div class="text-[8px] font-semibold text-ink">Snacks</div><div class="text-[7px] text-ink/40">Wedges, Nuggets, Rings</div></div></div>
            <div class="mt-3 bg-olive rounded p-2 text-center"><div class="text-[8px] text-white/80 uppercase tracking-wider">Schnellbestellung</div><div class="text-[9px] font-bold text-white">12 Artikel im Warenkorb</div></div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</section>
