---
const { stats } = Astro.props;
---

<section id="app" class="bg-alero-dark text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:py-20">
    <div>
      <p class="eyebrow">Alero App</p>
      <h2 class="mt-4 font-display text-4xl font-bold leading-tight sm:text-5xl">Bestellen, nachbestellen, Überblick behalten</h2>
      <p class="mt-5 max-w-xl text-base leading-8 text-white/70">Die Website soll später nicht nur schön aussehen, sondern direkt zur Bestellung führen. Darum bleibt die App als klarer Einstieg sichtbar.</p>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {stats.map(([value, label]) => (
          <div>
            <span class="stat">{value}</span>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="grid content-center gap-4 sm:grid-cols-2">
      <div class="review-card">
        <strong>Schneller Einkauf</strong>
        <p>Wiederkehrende Produkte und Aktionen sollen mit wenigen Klicks erreichbar sein.</p>
      </div>
      <div class="review-card">
        <strong>Für Profis</strong>
        <p>Sortiment, Verfügbarkeit und Kontakt stehen im Vordergrund, nicht Dekoration.</p>
      </div>
    </div>
  </div>
</section>
